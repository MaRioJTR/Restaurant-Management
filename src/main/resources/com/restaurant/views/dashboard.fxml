<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Role: Enhanced JavaFX dashboard view.
    Pattern: MVC view. This file only declares the layout; all actions delegate
    to DashboardController, which calls existing services/commands.
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.restaurant.controllers.DashboardController"
            prefWidth="760"
            prefHeight="520"
            style="-fx-background-color: #f6f7fb;">
    <top>
        <VBox spacing="10" BorderPane.alignment="CENTER" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(24, 32, 56, 0.10), 18, 0, 0, 4);">
            <padding>
                <Insets top="18" right="24" bottom="14" left="24"/>
            </padding>
            <HBox spacing="10">
                <Button fx:id="dashboardNavButton" text="Dashboard" style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Orders" onAction="#handleNavigateOrders" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;"/>
                <Button text="Menu" onAction="#handleNavigateMenu" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;"/>
                <Button text="Payments" onAction="#handleNavigatePayments" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;"/>
                <Button text="Kitchen" onAction="#handleNavigateKitchen" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="2">
                    <Label text="Restaurant Dashboard" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Label text="Live order operations" style="-fx-text-fill: #6b7280;"/>
                </VBox>
                <Label fx:id="refreshStatusLabel" text="Observer refresh ready" style="-fx-background-color: #e0f2fe; -fx-text-fill: #075985; -fx-padding: 6 10 6 10; -fx-background-radius: 16;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="14" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="24" right="24" bottom="12" left="24"/>
            </padding>
            <HBox spacing="12">
                <VBox spacing="4" style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(24, 32, 56, 0.08), 14, 0, 0, 3);">
                    <Label text="Latest Total" style="-fx-text-fill: #6b7280;"/>
                    <Label fx:id="orderTotalLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                </VBox>
                <VBox spacing="4" style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(24, 32, 56, 0.08), 14, 0, 0, 3);">
                    <Label text="Kitchen Feed" style="-fx-text-fill: #6b7280;"/>
                    <Label fx:id="kitchenStatusLabel" wrapText="true" style="-fx-font-weight: bold; -fx-text-fill: #111827;"/>
                </VBox>
            </HBox>
            <TableView fx:id="ordersTable" prefHeight="310" style="-fx-background-color: white; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="orderIdColumn" text="Order ID" prefWidth="180"/>
                    <TableColumn fx:id="tableColumn" text="Table" prefWidth="80"/>
                    <TableColumn fx:id="itemsColumn" text="Items" prefWidth="170"/>
                    <TableColumn fx:id="totalColumn" text="Total" prefWidth="100"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="230"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="12" BorderPane.alignment="CENTER_RIGHT">
            <padding>
                <Insets top="12" right="24" bottom="20" left="24"/>
            </padding>
            <Button text="Place Sample Order" onAction="#handlePlaceSampleOrder" style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>
</BorderPane>
