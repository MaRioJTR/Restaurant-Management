<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    Role: Enhanced JavaFX dashboard view.
    Pattern: MVC view. This file only declares the layout; all actions delegate
    to DashboardController, which calls existing services/commands.
-->

<BorderPane prefHeight="520" prefWidth="760" style="-fx-background-color: #f6f7fb;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.controllers.DashboardController">
    <top>
        <VBox spacing="10" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(24, 32, 56, 0.10), 18, 0, 0, 4);" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="14" left="24" right="24" top="18" />
            </padding>
            <HBox spacing="10">
                <Button fx:id="dashboardNavButton" style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-weight: bold;" text="Dashboard" />
                <Button onAction="#handleNavigateOrders" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;" text="Orders" />
                <Button onAction="#handleNavigateMenu" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;" text="Menu" />
                <Button onAction="#handleNavigatePayments" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;" text="Payments" />
                <Button onAction="#handleNavigateKitchen" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;" text="Kitchen" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="2">
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Restaurant Dashboard" />
                    <Label style="-fx-text-fill: #6b7280;" text="Live order operations" />
                </VBox>
                <Label fx:id="refreshStatusLabel" style="-fx-background-color: #e0f2fe; -fx-text-fill: #075985; -fx-padding: 6 10 6 10; -fx-background-radius: 16;" text="Observer refresh ready" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="14" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12" left="24" right="24" top="24" />
            </padding>
            <HBox spacing="12">
                <VBox spacing="4" style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(24, 32, 56, 0.08), 14, 0, 0, 3);">
                    <Label style="-fx-text-fill: #6b7280;" text="Latest Total" />
                    <Label fx:id="orderTotalLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                </VBox>
                <VBox spacing="4" style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(24, 32, 56, 0.08), 14, 0, 0, 3);">
                    <Label style="-fx-text-fill: #6b7280;" text="Kitchen Feed" />
                    <Label fx:id="kitchenStatusLabel" style="-fx-font-weight: bold; -fx-text-fill: #111827;" wrapText="true" />
                </VBox>
            </HBox>
            <TableView fx:id="ordersTable" prefHeight="310" style="-fx-background-color: white; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="orderIdColumn" prefWidth="180" text="Order ID" />
                    <TableColumn fx:id="tableColumn" prefWidth="80" text="Table" />
                    <TableColumn fx:id="itemsColumn" prefWidth="170" text="Items" />
                    <TableColumn fx:id="totalColumn" prefWidth="100" text="Total" />
                    <TableColumn fx:id="statusColumn" prefWidth="110" text="Status" />
                    <TableColumn fx:id="actionsColumn" prefWidth="230" text="Actions" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="12" BorderPane.alignment="CENTER_RIGHT">
            <padding>
                <Insets bottom="20" left="24" right="24" top="12" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>
