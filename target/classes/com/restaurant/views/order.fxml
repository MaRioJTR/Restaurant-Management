<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.restaurant.controllers.OrderController"
            prefWidth="980"
            prefHeight="640"
            style="-fx-background-color: #f6f7fb;">
    <top>
        <VBox spacing="10" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(24, 32, 56, 0.10), 18, 0, 0, 4);">
            <padding>
                <Insets top="18" right="24" bottom="14" left="24"/>
            </padding>
            <HBox spacing="10">
                <Button text="Dashboard" onAction="#handleDashboard" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;"/>
                <Button text="Orders" style="-fx-background-color: #1d4ed8; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Menu" onAction="#handleMenu" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;"/>
                <Button text="Payments" onAction="#handlePayments" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;"/>
                <Button text="Kitchen" onAction="#handleKitchen" style="-fx-background-color: #eef2ff; -fx-text-fill: #1d4ed8;"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="2">
                    <Label text="Order Management" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Label text="Filter and act on active restaurant orders." style="-fx-text-fill: #6b7280;"/>
                </VBox>
                <ComboBox fx:id="statusFilter" prefWidth="160"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <TableView fx:id="ordersTable" prefHeight="460" style="-fx-background-color: white; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="orderIdColumn" text="Order ID" prefWidth="160"/>
                    <TableColumn fx:id="tableColumn" text="Table" prefWidth="90"/>
                    <TableColumn fx:id="itemCountColumn" text="Items" prefWidth="100"/>
                    <TableColumn fx:id="totalColumn" text="Total" prefWidth="120"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="130"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="300"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
